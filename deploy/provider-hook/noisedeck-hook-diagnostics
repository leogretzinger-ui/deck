#!/usr/bin/python3
"""Opt-in, bounded hook-stage records in the launch's private TMPDIR."""

import fcntl
import json
import os
import stat
import sys

MAX_BYTES = 4096
STAGES = frozenset((
    "adapter_entered", "adapter_invalid_json", "adapter_invalid_shape",
    "adapter_unsupported_event", "adapter_missing_session_id", "adapter_forwarded",
    "adapter_forward_timeout", "adapter_forward_unavailable", "receiver_entered",
    "receiver_missing_launch_env", "receiver_payload_unavailable", "receiver_clock_unavailable",
    "receiver_attempt", "receiver_accepted", "receiver_client_refused",
    "receiver_unexpected_status", "receiver_deadline", "receiver_retry_exhausted",
))


def record(stage, attempt=0, curl_exit=0, http_status=0):
    if os.environ.get("NOISEDECK_HOOK_DIAGNOSTICS") != "true" or stage not in STAGES:
        return
    entry = {"stage": stage}
    if stage == "receiver_attempt":
        if not (1 <= attempt <= 3 and 0 <= curl_exit <= 255 and
                (http_status == 0 or 100 <= http_status <= 599)):
            return
        entry.update(attempt=attempt, curl_exit=curl_exit, http_status=http_status)
    data = (json.dumps(entry, separators=(",", ":")) + "\n").encode("ascii")
    directory = os.environ.get("TMPDIR", "")
    if not os.path.isabs(directory):
        return
    directory_fd = file_fd = None
    try:
        directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        info = os.fstat(directory_fd)
        if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
            return
        file_fd = os.open("hook-diagnostics.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND |
                          os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=directory_fd)
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or \
                stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1:
            return
        fcntl.flock(file_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if os.fstat(file_fd).st_size + len(data) <= MAX_BYTES:
            os.write(file_fd, data)
    except (OSError, ValueError):
        pass
    finally:
        for fd in (file_fd, directory_fd):
            if fd is not None:
                os.close(fd)


if __name__ == "__main__":
    try:
        if len(sys.argv) == 2:
            record(sys.argv[1])
        elif len(sys.argv) == 5:
            record(sys.argv[1], *(int(value) for value in sys.argv[2:]))
    except (ValueError, TypeError):
        pass
