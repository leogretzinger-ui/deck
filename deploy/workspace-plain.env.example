# Copy to the plain.ComposeEnvFile path in the installation JSON, owned by
# the dedicated host user with mode 0600. Replace all example values before use.
# Keep this file separate from the encrypted branch's Compose environment and
# the gateway supervisor's private environment. Never source it as shell.

# Load this exact image into the dedicated owner's rootless Podman store.
# It must include the mempalace target and the container UID/GID below.
NOISEDECK_IMAGE_TAG=replace-with-installed-image-tag
NOISEDECK_RUNTIME_UID=1026
NOISEDECK_RUNTIME_GID=100

# Match the gateway JSON client/account. The gateway supervisor receives the
# same client secret as NOISEDECK_AUTH_GOOGLE_CLIENT_SECRET and the same session
# secret as NOISEDECK_AUTH_SESSION_SECRET. These are illustrative placeholders.
NOISEDECK_AUTH_MODE=oidc
GOOGLE_OIDC_CLIENT_ID=example-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OIDC_ALLOWED_EMAIL=owner@example.test
NOISEDECK_AUTH_SESSION_SECRET=replace-with-independent-random-session-secret

# Set the SHA-256 of the deployment host's /etc/machine-id before starting.
NOISEDECK_DEPLOYMENT_HOST_SHA256=replace-with-host-machine-id-sha256

# The controller supplies the project/container identity, state root and HTTPS
# origin from JSON. The wrapper supplies NOISEDECK_MEMPALACE_HOST_PATH inside
# that root. Its overlays select the private Unix listener and replace all
# workload binds; do not add ordinary host project or credential-home mounts.
